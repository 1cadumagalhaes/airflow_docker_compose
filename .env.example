# PostgreSQL Configuration
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_PORT=5432

# Airflow Configuration
AIRFLOW_UID=1000
AIRFLOW_PROJ_DIR=.
AIRFLOW_IMAGE_NAME=airflow-local:latest
AIRFLOW_WEB_PORT=8080
LOAD_EXAMPLES=false

# Shared JWT signing key between scheduler and api-server (must be equal).
# Generate a new one with: openssl rand -base64 24
AIRFLOW__API_AUTH__JWT_SECRET=QmdJdXRoc2VjcmV0X2tleV9mb3JfbG9jYWxfZGV2XzIwMjY=

# Local development: disable authentication (SimpleAuthManager with all-admins)
# Set SIMPLE_AUTH_MANAGER_ALL_ADMINS=false and list users to enable login
SIMPLE_AUTH_MANAGER_ALL_ADMINS=true
SIMPLE_AUTH_MANAGER_USERS=

# Airflow Project Directory (if running from elsewhere)
# AIRFLOW_PROJ_DIR=.